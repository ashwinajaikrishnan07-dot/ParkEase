PORT=5000
MONGO_URI=mongodb://localhost:27017/parkwise
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional — enables "Continue with Google" sign-in.
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 as an authorized JavaScript origin, then paste the Client ID here.
# The client fetches this value from GET /api/auth/config, so no separate client env is needed.
# Leave blank to keep Google sign-in disabled; email/password login still works.
GOOGLE_CLIENT_ID=

# Optional — enables real destination photos via the Google Places API (New).
# Enable "Places API (New)" in Google Cloud, create an API key, paste it here,
# then run: node utils/fetchPlacePhotos.js
# Used only server-side; the resulting public photo URLs are stored on each
# destination, so the key is never exposed to the browser.
GOOGLE_MAPS_API_KEY=
